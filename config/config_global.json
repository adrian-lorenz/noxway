{
  "ssl": false,
  "debug": false,
  "excludedPaths": [],
  "port": "8080",
  "sslPort": "443",
  "sslDomain": "",
  "sslCertDays": 0,
  "sslMail": "",
  "cors": true,
  "rateLimiter": true,
  "bann": false,
  "metric": false,
  "prefix": "/v1/",
  "pemCrt": "./certs/cert.pem",
